# Supabase frontend configuration. Copy to .env and fill in your project settings.
# Keep values empty until configured so local guest mode remains available.
# Project URL example: https://your-project.supabase.co
VITE_SUPABASE_URL=

# Browser-safe publishable key from your Supabase project.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback; leave empty when using the publishable key above.
VITE_SUPABASE_ANON_KEY=

# Never put service-role keys, secret API keys or database passwords in VITE_* variables.

# Optional real Supabase demo accounts for LOCAL DEVELOPMENT ONLY.
# Use dedicated test accounts. The admin can edit the shared lesson catalog.
# Keep these unprefixed: Vite injects them only during dev, never during a build.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
